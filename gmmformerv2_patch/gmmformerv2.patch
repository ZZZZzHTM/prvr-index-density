@@ -0,0 +1,21 @@
+"""Portable configuration without import-time filesystem writes."""
+import copy
+import os
+
+
+def finalize_config(defaults, overrides=None, write=False):
+    cfg = copy.deepcopy(defaults)
+    cfg.update({key: value for key, value in (overrides or {}).items() if value is not None})
+    cfg['num_workers'] = int(cfg['num_workers'])
+    if cfg['num_workers'] < 0:
+        raise ValueError('num_workers must be nonnegative')
+    cfg['num_workers'] = 1 if cfg['no_core_driver'] else cfg['num_workers']
+    cfg['pin_memory'] = not cfg['no_pin_memory']
+    cfg['model_root'] = os.path.join(str(cfg['root']), 'results', cfg['dataset_name'], cfg['model_name'])
+    cfg['ckpt_path'] = os.path.join(cfg['model_root'], 'ckpt')
+    if write:
+        import yaml
+        os.makedirs(cfg['ckpt_path'], exist_ok=True)
+        with open(os.path.join(cfg['model_root'], 'hyperparams.yaml'), 'w', encoding='utf-8') as stream:
+            yaml.safe_dump(cfg, stream, allow_unicode=True)
+    return cfg
