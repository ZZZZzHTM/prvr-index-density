@@ -0,0 +1,29 @@
+"""Train-only, video-level development split; no tensor or feature imports."""
+import math
+import random
+
+
+def split_captions(lines, split_seed=20261023, dev_fraction=0.1):
+    if not 0 < dev_fraction < 1:
+        raise ValueError('dev_fraction must be between zero and one')
+    query_ids = [line.split(' ', 1)[0] for line in lines]
+    if len(query_ids) != len(set(query_ids)):
+        raise ValueError('Duplicate query IDs in training annotations')
+    video_order = list(dict.fromkeys(query.split('#', 1)[0] for query in query_ids))
+    ndev = math.ceil(len(video_order) * dev_fraction)
+    if not 0 < ndev < len(video_order):
+        raise ValueError('The train/dev split needs at least one video on each side')
+    selected = set(random.Random(split_seed).sample(video_order, ndev))
+    ids = {'train_sub': [v for v in video_order if v not in selected],
+           'dev': [v for v in video_order if v in selected]}
+    captions = {}
+    for side, videos in ids.items():
+        membership = set(videos)
+        captions[side] = [line for line in lines if line.split(' ', 1)[0].split('#', 1)[0] in membership]
+    assert not set(ids['train_sub']) & set(ids['dev'])
+    assert sum(len(rows) for rows in captions.values()) == len(lines)
+    return ids, captions
+
+
+def encoded_lines(lines):
+    return ('\n'.join(lines) + '\n').encode('utf-8')
